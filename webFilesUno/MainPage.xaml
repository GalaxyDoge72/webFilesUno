<Page
    x:Class="webFilesUno.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView x:Name="NavView" PaneDisplayMode="Left" IsSettingsVisible="False">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Downloads" Icon="Download" Tag="download" />
            <NavigationViewItem Content="Extraction" Icon="SaveLocal" Tag="extraction" />
            <NavigationViewItem Content="De-Duplication" Icon="Copy" Tag="dedupe" />
            <NavigationViewItem Content="Image Compression" Icon="Pictures" Tag="compress" />
            <NavigationViewItem Content="Video" Icon="Video" Tag="video" />
        </NavigationView.MenuItems>

        <ScrollViewer Padding="24" HorizontalScrollBarVisibility="Auto">
            <StackPanel Spacing="20" HorizontalAlignment="Stretch">
                
                <StackPanel x:Name="DownloadSection" Spacing="15" HorizontalAlignment="Stretch">
                    <Grid HorizontalAlignment="Stretch">
                        <TextBlock Text="Kemono Downloader" FontSize="28" FontWeight="Bold" Grid.Column="1" Foreground="{ThemeResource SystemAccentColor}"/>
                    </Grid>


                    <Grid RowSpacing="10" ColumnSpacing="12" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /> <ColumnDefinition Width="*" />    <ColumnDefinition Width="Auto" /> <ColumnDefinition Width="200" />  </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Base URL:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>
                        <ComboBox x:Name="BaseUrlComboBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="kemono.cr" IsSelected="True"/>
                            <ComboBoxItem Content="coomer.st"/>
                        </ComboBox>

                        <TextBlock Text="Link:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"/>
                        <TextBox x:Name="kemonoLinkTextBox" PlaceholderText="https://kemono.cr/..." Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"/>
                        
                        <TextBlock Text="Folder:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="2"/>
                        <TextBox x:Name="folderNameTextBox" PlaceholderText="patreon-12345" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Stretch"/>
                    </Grid>

                    <Expander Header="File Types to Include" IsExpanded="True" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Pictures" FontWeight="SemiBold"/>
                            <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="100">
                                <CheckBox x:Name="jpegCheckBox" Content=".jpg" IsChecked="True"/>
                                <CheckBox x:Name="pngCheckBox" Content=".png" IsChecked="True"/>
                                <CheckBox x:Name="gifCheckBox" Content=".gif" IsChecked="True"/>
                                <CheckBox x:Name="psdCheckBox" Content=".psd" IsChecked="True"/>
                            </VariableSizedWrapGrid>

                            <TextBlock Text="Videos" FontWeight="SemiBold"/>
                            <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="100">
                                <CheckBox x:Name="mpegCheckBox" Content=".mp4" IsChecked="True"/>
                                <CheckBox x:Name="movCheckBox" Content=".mov" IsChecked="True"/>
                                <CheckBox x:Name="webmCheckBox" Content=".webm" IsChecked="True"/>
                            </VariableSizedWrapGrid>

                            <TextBlock Text="Audio" FontWeight="SemiBold"/>
                            <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="100">
                                <CheckBox x:Name="mpegAudioCheckBox" Content=".mp3" IsChecked="True"/>
                                <CheckBox x:Name="wavCheckBox" Content=".wav" IsChecked="True"/>
                                <CheckBox x:Name="mFourACheckBox" Content=".m4a" IsChecked="True"/>
                                <CheckBox x:Name="flacCheckBox" Content=".flac" IsChecked="True"/>
                                <CheckBox x:Name="oggCheckBox" Content=".ogg" IsChecked="True"/>
                            </VariableSizedWrapGrid>

                            <TextBlock Text="Archives" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="100">
                                <CheckBox x:Name="zipCheckBox" Content=".zip" IsChecked="True"/>
                                <CheckBox x:Name="rarCheckBox" Content=".rar" IsChecked="True"/>
                                <CheckBox x:Name="sevenZipCheckBox" Content=".7z" IsChecked="True"/>
                            </VariableSizedWrapGrid>
                        </StackPanel>
                    </Expander>

                    <Grid ColumnDefinitions="*, Auto" HorizontalAlignment="Stretch">
                        <StackPanel Grid.Column="0" MaxWidth="300" HorizontalAlignment="Left">
                            <TextBlock x:Name="maxDownloadsLabel" Text="Max Downloads: 4"/>
                            <Slider x:Name="maxDownloadsBar" Minimum="1" Maximum="10" Value="4" TickFrequency="1" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <CheckBox x:Name="NoThumbnailCheckBox" Content="Skip Thumbnails" Grid.Column="1" VerticalAlignment="Bottom"/>
                    </Grid>

                    <Button x:Name="StartDownloadButton" 
                            Content="Begin Download" 
                            Style="{StaticResource AccentButtonStyle}" 
                            HorizontalAlignment="Stretch" 
                            Height="45" 
                            Click="startDownload_Click"/>
                    
                    <InfoBar x:Name="StatusInfoBar" Title="Status" Message="Inactive" IsOpen="True" IsClosable="False" HorizontalAlignment="Stretch" />
                </StackPanel>

                <ItemsControl x:Name="flowLayoutPanelDownloads" HorizontalAlignment="Stretch">
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </NavigationView>
</Page>